{
  "$schema": "https://pgtools.dev/schemas/0.0.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      // "recommended": true,
      "all": true
    }
  },
  "migrations": {
    "migrationsDir": "supabase/migrations"
  }
}
